<!-- Aircraft -->
  <link name="aircraft">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="aircraft.STL" scale="1 1 1"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/aircraft.STL" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="roll_input_joint" type="revolute">
    <parent link="aircraft"/>
    <child link="dummy_link"/>
    <origin xyz="0 0 0" rpy="1.5707 0 -1.5707"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.87266" upper="0.87266" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="dummy_link" />

  <joint name="pitch_input_joint" type="prismatic">
    <parent link="dummy_link"/>
    <child link="steering_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.165" upper="0" effort="10.0" velocity="1.0"/>
  </joint>

