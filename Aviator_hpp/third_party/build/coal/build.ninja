  COMMAND = cd /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/coal && export LD_LIBRARY_PATH= && export LD_LIBRARY_PATH= && export PYTHONPATH= && ! test x$$VERSION = x || ( echo Please\ set\ a\ version\ for\ this\ release && false ) && if [ -f package.xml ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal --target coal-release_package_xml ) fi && if [ -f pyproject.toml ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal --target coal-release_pyproject_toml ) fi && if [ -f CHANGELOG.md ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal --target coal-release_changelog ) fi && if [ -f pixi.toml ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal --target coal-release_pixi_toml ) fi && if [ -f CITATION.cff ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal --target coal-release_citation_cff ) fi && /usr/bin/git tag -s v$$VERSION -m Release\ of\ version\ $$VERSION. && cd /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal && cmake /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/coal && /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal --target coal-distcheck || ( echo Please\ fix\ distcheck\ first. && cd /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/coal && /usr/bin/git tag -d v$$VERSION && cd /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal && cmake /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/coal && false ) && /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal --target coal-dist && /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/coal --target coal-distclean && echo Please,\ run\ 'git\ push\ --tags'\ and\ upload\ the\ tarball\ to\ github\ to\ finalize\ this\ release.
  DESC = Create a new release for coal


