  COMMAND = cd /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/proxsuite && export LD_LIBRARY_PATH= && export LD_LIBRARY_PATH= && export PYTHONPATH= && ! test x$$VERSION = x || ( echo Please\ set\ a\ version\ for\ this\ release && false ) && if [ -f package.xml ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite --target proxsuite-release_package_xml ) fi && if [ -f pyproject.toml ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite --target proxsuite-release_pyproject_toml ) fi && if [ -f CHANGELOG.md ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite --target proxsuite-release_changelog ) fi && if [ -f pixi.toml ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite --target proxsuite-release_pixi_toml ) fi && if [ -f CITATION.cff ]; then ( /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite --target proxsuite-release_citation_cff ) fi && /usr/bin/git tag -s v$$VERSION -m Release\ of\ version\ $$VERSION. && cd /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite && cmake /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/proxsuite && /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite --target proxsuite-distcheck || ( echo Please\ fix\ distcheck\ first. && cd /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/proxsuite && /usr/bin/git tag -d v$$VERSION && cd /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite && cmake /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/proxsuite && false ) && /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite --target proxsuite-dist && /usr/bin/cmake --build /home/sia/Documents/GitHub/AVIATOR/Aviator_hpp/third_party/build/proxsuite --target proxsuite-distclean && echo Please,\ run\ 'git\ push\ --tags'\ and\ upload\ the\ tarball\ to\ github\ to\ finalize\ this\ release.
